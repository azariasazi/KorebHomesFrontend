{
  "expo": {
    "name": "Koreb Homes",
    "slug": "koreb-homes",
    "scheme": "korebhomes",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#14181A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.korebhomes.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14181A"
      },
      "package": "com.korebhomes.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": { 
      "apiUrl": "https://koreb-backend-production.up.railway.app/api/v1" 
    }
  }
}
